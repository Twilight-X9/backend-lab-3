{
  "info": {
    "_postman_id": "b3e94a81-d142-4f8e-9081-3fcfcb891a32",
    "name": "Backend Lab 3 - REST API and Validation",
    "description": "Postman test suite for Lab 3 covering REST endpoints, query parameters, search, sorting, filtering, validation, and status codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Query Parameters & Filtering",
      "item": [
        {
          "name": "1. GET All Books (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "2. GET Search by Title (search_q=JavaScript)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?search_q=JavaScript",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search_q",
                  "value": "JavaScript"
                }
              ]
            }
          }
        },
        {
          "name": "3. GET Sort by Price Descending (order_by=price&order=DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?order_by=price&order=DESC",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            }
          }
        },
        {
          "name": "4. GET Pagination (limit=3&offset=0)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?limit=3&offset=0",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "5. GET Price Range Filter (min_price=300&max_price=500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?min_price=300&max_price=500",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "min_price",
                  "value": "300"
                },
                {
                  "key": "max_price",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "6. GET Combined Search and Sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?search_q=Code&order_by=price&order=ASC",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search_q",
                  "value": "Code"
                },
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "ASC"
                }
              ]
            }
          }
        }
      ]
    },
    {
